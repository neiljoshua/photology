#test 
# Ignore bundler config.
/.bundle

.DS_Store

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal
/public/system/
/config.database.yml.sqlite3

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/node_modules
/yarn-error.log

#Sass files
.sass-cache

.byebug_history

